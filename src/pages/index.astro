---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import About from '../components/About.astro';
import Clients from '../components/Clients.astro';
import Products from '../components/Products.astro';
import Process from '../components/Process.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import Floating from '../components/Floating.astro';
import { homeFaqs } from '../data/faq';
import { homeJsonLd } from '../data/jsonld';

const title = 'Software a Medida en Bogotá para Pymes | ZentroSoft';
const description =
  'ZentroSoft: empresa de desarrollo de software en Bogotá. Software a medida, aplicaciones web, plataformas SaaS, landing pages y SEO para pymes.';
const keywords =
  'desarrollo de software, empresa de desarrollo de software, desarrollo web, agencia de desarrollo web, software a medida, desarrollo de aplicaciones web, creación de páginas web, soluciones tecnológicas, desarrollo SaaS, automatización de procesos, transformación digital, software empresarial, desarrollo de sistemas web, plataformas digitales, aplicaciones empresariales, desarrollo web Colombia, desarrollo de software Colombia, desarrollo web Bogotá, software a medida Colombia, empresa tecnológica, desarrollo web Bogotá, ZentroSoft';
---

<BaseLayout
  title={title}
  description={description}
  canonical="https://zentrosoft.vercel.app/"
  ogUrl="https://zentrosoft.vercel.app/"
  keywords={keywords}
  jsonLd={homeJsonLd}
  preloadHero
>
  <Header />
  <Hero />
  <main id="contenido">
    <Services />
    <About />
    <Clients />
    <Products />
    <Process />
    <CtaBand />
    <Faq faqs={homeFaqs} />
  </main>
  <Contact />
  <Footer />
  <Floating />

  <script>
    import { initCookieConsent } from '../scripts/cookie-consent';
    import { initContactForm } from '../scripts/contact-form';
    import {
      initHeaderScroll,
      initSmoothScroll,
      initMobileMenu,
      initCountUp,
      initScrollAnimations,
      initToTop,
    } from '../scripts/ui';
    import { initHeroCarousel, initRotatingWord, initNewsCarousel, initDiagnosticCTA } from '../scripts/home';
    import { initConversionTracking } from '../scripts/analytics';

    initHeroCarousel();
    initCountUp();
    initRotatingWord();
    initNewsCarousel();
    initHeaderScroll();
    initSmoothScroll();
    initScrollAnimations();
    initMobileMenu();
    initDiagnosticCTA();
    initCookieConsent();
    initContactForm();
    initConversionTracking();
    initToTop();
  </script>
</BaseLayout>
